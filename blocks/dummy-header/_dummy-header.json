{
  "definitions": [
    {
      "title": "Dummy Header",
      "id": "dummy-header",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 3,
          "fields": [
            {
              "name": "logo",
              "selector": "div:nth-child(1) > div > picture > img[src]"
            },
            {
              "name": "logoAlt",
              "selector": "div:nth-child(1) > div > picture > img[alt]"
            },
            {
              "name": "logoLink",
              "selector": "div:nth-child(1) > div > a[href]"
            },
            {
              "name": "navItems",
              "selector": "div:nth-child(2) > div > ul"
            },
            {
              "name": "classes",
              "selector": "div:nth-child(3) > div > ul"
            }
          ]
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Dummy Header",
              "model": "dummy-header",
              "classes": ["sticky", "light"]
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "dummy-header",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "logo",
          "label": "Brand Logo / Title Image",
          "description": "Upload the main logo image (e.g. Button logo).",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "logoAlt",
          "value": "",
          "label": "Logo Alt Text",
          "description": "Alternative text for accessibility."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "logoLink",
          "value": "/",
          "label": "Logo Link URL",
          "description": "Destination link when clicking the logo/brand name."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "navItems",
          "value": "",
          "label": "Navigation Links",
          "description": "Add top-level menu items (e.g., Examples, Getting Started, Documentation) as a bulleted list with hyperlinks."
        },
        {
          "component": "multiselect",
          "name": "classes",
