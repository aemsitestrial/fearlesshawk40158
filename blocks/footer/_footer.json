{
  "definitions": [
    {
      "title": "Footer",
      "id": "footer",
      "plugins": {
        "da": {
          "rows": 6,
          "columns": 1,
          "fields": [
            { "name": "classes", "selector": "div:nth-child(1)>div>ul" },
            { "name": "logo", "selector": "div:nth-child(2)>div>picture>img[src]" },
            { "name": "description", "selector": "div:nth-child(3)>div" },
            { "name": "navLinks", "selector": "div:nth-child(4)>div" },
            { "name": "socialLinks", "selector": "div:nth-child(5)>div" },
            { "name": "copyright", "selector": "div:nth-child(6)>div" }
          ]
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Footer",
              "model": "footer",
              "classes": ["dark", "multi-column"]
            }
          }
        }
      }
    }
  ],
  "models": [
