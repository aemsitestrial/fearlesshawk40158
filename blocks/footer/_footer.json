              "name": "Layout Variations",
              "children": [
                { "name": "Multi-Column Layout", "value": "multi-column" },
                { "name": "Minimal Single-Row Layout", "value": "minimal" },
                { "name": "Centered Brand Focus", "value": "centered" },
                { "name": "Accordion Mobile Layout", "value": "accordion" },
                { "name": "Newsletter Split Layout", "value": "newsletter-split" }
              ]
            },
            {
              "name": "Color Themes",
              "children": [
                { "name": "Dark Theme", "value": "dark" },
                { "name": "Light Theme", "value": "light" },
                { "name": "Brand Accent Theme", "value": "brand-accent" },
                { "name": "Gradient Glass Theme", "value": "gradient-glass" }
              ]
            }
          ]
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "logo",
          "label": "Footer Logo",
