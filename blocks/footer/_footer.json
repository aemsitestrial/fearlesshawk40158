          "description": "Add links for LinkedIn, Twitter, Facebook, YouTube."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "copyright",
          "label": "Copyright & Legal Text",
          "value": "© 2026 All Rights Reserved."
        }
